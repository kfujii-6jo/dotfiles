{{/* chezmoi:modify-template */}}
{{- $defaults := `{
  "packages": [
    "npm:pi-web-access@0.40.0",
    "npm:pi-lens@4.4.3",
    "npm:pi-subagents@0.78.0",
    "npm:pi-mcp-adapter@5.3.0",
    "npm:pi-interactive-shell@0.17.1",
    "npm:pi-rewind-hook@1.8.7",
    "npm:@narumitw/pi-caffeinate@0.49.11"
  ],
  "subagents": {
    "watchdog": {
      "enabled": false,
      "children": { "enabled": false }
    }
  }
}` | fromJson -}}
{{- $current := .chezmoi.stdin | fromJson | default dict -}}
{{ mergeOverwrite $current $defaults | toPrettyJson }}
