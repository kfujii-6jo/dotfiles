{
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium",
  "packages": [
    "npm:pi-web-access@0.40.0",
    "npm:@narumitw/pi-caffeinate@0.49.11"
  ],
  "extensions": [
    "-builtin:mcp",
    "~/.pi/agent/extensions/herdr-agent-state.ts"
  ],
  "defaultTools": [
    "read",
    "grep",
    "find",
    "ls",
    "web_search",
    "source_check",
    "fetch_content",
    "get_search_content",
    "web_enable"
  ],
  "skills": [
    "!{{ .chezmoi.homeDir }}/.agents/skills/**"
  ]
}
