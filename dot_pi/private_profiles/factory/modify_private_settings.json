{{/* chezmoi:modify-template */}}
{{/* Model preferences are initial defaults; profile resources stay managed. */}}
{{- $initial := `{
  "defaultProvider": "openai",
  "defaultModel": "gpt-6.1-sol",
  "defaultThinkingLevel": "medium"
}` | fromJson -}}
{{- $managed := `{
  "packages": [
    "npm:pi-web-access@0.40.0",
    {
      "source": "npm:pi-subagents@0.78.0",
      "skills": [],
      "prompts": []
    },
    "npm:@narumitw/pi-caffeinate@0.49.11"
  ],
  "extensions": [
    "-builtin:mcp",
    "~/.pi/agent/extensions/herdr-agent-state.ts"
  ],
  "defaultTools": [
    "read",
    "grep",
    "find",
    "ls",
    "web_search",
    "source_check",
    "fetch_content",
    "get_search_content",
    "web_enable",
    "bash",
    "edit",
    "write",
    "subagents_enable",
    "subagent",
    "bg_wait"
  ],
  "subagents": {
    "watchdog": {
      "enabled": false,
      "children": {
        "enabled": false
      }
    },
    "agentOverrides": {
      "factory-reviewer": {
        "model": "inherit",
        "thinking": "high",
        "advertise": true
      }
    }
  }
}` | fromJson -}}
{{- $skillsDir := joinPath .chezmoi.homeDir ".agents" "skills" -}}
{{- $_ := set $managed "skills" (list
  (printf "%s" $skillsDir)
) -}}
{{- $current := .chezmoi.stdin | default "{}" | mustFromJson | default dict -}}
{{ mergeOverwrite $initial $current $managed | toPrettyJson }}
