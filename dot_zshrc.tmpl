{{- $brewPrefix := output "brew" "--prefix" | trim -}}
stty -ixon

export ZSH=$HOME/.oh-my-zsh
ZSH_THEME="robbyrussell"
plugins=(git)
source $ZSH/oh-my-zsh.sh

export EDITOR="nvim"
export XDG_CONFIG_HOME=$HOME/.config
export PATH="$HOME/.local/bin:$PATH"

export MISE_GITHUB_TOKEN="$(gh auth token 2>/dev/null)"

eval "$(~/.local/bin/mise activate zsh)"
eval "$(git wt --init zsh)"

export AQUA_GLOBAL_CONFIG="${XDG_CONFIG_HOME:-$HOME/.config}/aquaproj-aqua/aqua.yaml"
export PATH="${AQUA_ROOT_DIR:-${XDG_DATA_HOME:-$HOME/.local/share}/aquaproj-aqua}/bin:$PATH"

export PNPM_HOME="$HOME/Library/pnpm"
case ":$PATH:" in
  *":$PNPM_HOME/bin:"*) ;;
  *) export PATH="$PNPM_HOME/bin:$PATH" ;;
esac

export FZF_DEFAULT_OPTS="--height=40% --layout=reverse --border"

alias vim="nvim"
alias gvim='/Applications/Ghostty.app/Contents/MacOS/ghostty --font-size=16 -e nvim'
alias gu="gitui"
alias rp='cd $(ghq list -p | fzf --with-nth=5.. -d/) && ls -la'
alias trel="tmux source-file ~/.tmux.conf && echo 'Reloaded!'"
alias taf='tmux attach -t $(tmux list-sessions -F "#{session_name}" | fzf)'
alias tkf='tmux kill-session -t $(tmux list-sessions -F "#{session_name}" | fzf)'
alias tkw='tmux kill-window -t $(tmux list-windows -F "#{window_index}: #{window_name}" | fzf | cut -d: -f1)'
alias hcp="history | sed 's/^ *[0-9]* *//' | awk '!seen[\$0]++' | fzf | pbcopy"
alias nvim-dev='NVIM_APPNAME=nvim-dev nvim'
alias gsw='git switch $(git branch --format="%(refname:short)" | fzf)'
alias gbd='git branch -d $(git branch --format="%(refname:short)" | fzf -m)'
alias hd='hunk diff'
alias hpr='hunk diff main...HEAD'
alias hsh='hunk show'

if command -v wt >/dev/null 2>&1; then eval "$(command wt config shell init zsh)"; fi
export PATH="$PATH:$HOME/.turso"

export PATH="{{ $brewPrefix }}/opt/curl/bin:{{ $brewPrefix }}/opt/git/bin:$PATH"
# Use Homebrew's patched CA bundle instead of macOS's outdated PEM file.
export SSL_CERT_FILE="{{ $brewPrefix }}/etc/ca-certificates/cert.pem"
export CURL_CA_BUNDLE="$SSL_CERT_FILE"
# Homebrew Git links Apple's libcurl and needs its own CA override.
export GIT_SSL_CAINFO="$SSL_CERT_FILE"
export REQUESTS_CA_BUNDLE="$SSL_CERT_FILE"
export PIP_CERT="$SSL_CERT_FILE"
